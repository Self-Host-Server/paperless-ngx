# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me

# Public URL this instance is served from, e.g. https://paperless.example.com
PAPERLESS_URL=http://localhost:8000

PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=eng

# Match these to your host user so file ownership works with bind mounts
USERMAP_UID=1000
USERMAP_GID=1000

# Comma-separated list of hosts allowed to serve the app (needed behind a reverse proxy)
PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1
PAPERLESS_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# OIDC via Authentik (django-allauth).
# 1. In Authentik, create an OAuth2/OpenID provider + application for paperless-ngx.
#    Set its redirect URI to: <PAPERLESS_URL>/accounts/oidc/authentik/login/callback/
# 2. Replace <authentik.example.com> and <app-slug> below with your Authentik host
#    and the application's slug, and fill in the client_id/secret from that provider.
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"APPS":[{"provider_id":"authentik","name":"Authentik","client_id":"change-me","secret":"change-me","settings":{"server_url":"https://<authentik.example.com>/application/o/<app-slug>/.well-known/openid-configuration"}}]}}
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_DISABLE_REGULAR_LOGIN=false
PAPERLESS_REDIRECT_LOGIN_TO_SSO=false

# Group new SSO signups are auto-added to (must already exist in paperless-ngx,
# see INSTRUCTIONS.md step 3 for creating it with baseline permissions).
# Without this, new SSO users get zero permissions and hit a 403 on first login.
PAPERLESS_SOCIAL_ACCOUNT_DEFAULT_GROUPS=SSO Users

# Receipt -> expense-statement automation (post-consume script).
# Generate PAPERLESS_API_TOKEN from an existing user's API token in the
# paperless-ngx admin (or via `manage.py drf_create_token <username>`).
PAPERLESS_API_TOKEN=
# Tag that must be applied to a document for the hook to process it as a receipt.
PAPERLESS_RECEIPT_TAG=Receipt
OLLAMA_BASE_URL=http://192.168.1.14:11434
OLLAMA_EXTRACTION_MODEL=qwen2.5:7b
# monthly | semimonthly | biweekly
EXPENSE_PERIOD_CADENCE=monthly
# Required (YYYY-MM-DD) only when EXPENSE_PERIOD_CADENCE=biweekly.
EXPENSE_PERIOD_ANCHOR=
EMPLOYEE_NAME=
